{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Armasync",
  "version": "0.2.6",
  "identifier": "nl.lowtac.armasync",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Armasync",
        "decorations": false,
        "width": 1180,
        "height": 760,
        "minWidth": 680,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "category": "Game",
    "homepage": "https://github.com/Pekururu/Armasync-Linux",
    "publisher": "Armasync contributors",
    "shortDescription": "Native Linux Arma 3 launcher and addon manager",
    "longDescription": "A native Linux Arma3Sync replacement for Arma 3 unit play: addon groups, Arma3Sync-compatible repository synchronization, Steam/Proton launching, and TeamSpeak 3/ACRE setup.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "recommends": ["steam", "protontricks", "pipewire", "wireplumber", "pipewire-pulse", "zstd"],
        "section": "games",
        "priority": "optional"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"],
        "recommends": ["steam", "protontricks", "pipewire", "wireplumber", "pipewire-pulse", "zstd"],
        "release": "1"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
